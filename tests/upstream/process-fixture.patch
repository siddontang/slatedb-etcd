+	if ep.cfg.ExecPath == BinPath.Etcd {
+		ready, cancel := context.WithTimeout(ctx, 20*time.Second)
+		defer cancel()
+		flags := ep.Etcdctl().flags()
+		cfg, err := clientv3.NewClientConfig(&clientv3.ConfigSpec{
+			Endpoints: ep.EndpointsGRPC(),
+			Secure: &clientv3.SecureConfig{
+				Cert: flags["cert"], Key: flags["key"], Cacert: flags["cacert"],
+				InsecureTransport: ep.cfg.Client.ConnectionType != ClientTLS,
+				InsecureSkipVerify: flags["insecure-skip-tls-verify"] == "true",
+			},
+		}, ep.cfg.lg)
+		if err != nil {
+			return err
+		}
+		cfg.Context = ready
+		client, err := clientv3.New(*cfg)
+		if err != nil {
+			return err
+		}
+		defer client.Close()
+		probe := grpchealth.NewHealthClient(client.ActiveConnection())
+		for {
+			state, err := probe.Check(ready, &grpchealth.HealthCheckRequest{})
+			if err == nil && state.Status == grpchealth.HealthCheckResponse_SERVING {
+				break
+			}
+			select {
+			case <-ready.Done():
+				return fmt.Errorf("gRPC health check: %w", ready.Err())
+			case <-time.After(100 * time.Millisecond):
+			}
+		}
+	}
